NODE_ENV=development
PORT=4000
# Atlas connection string including the database name, e.g. mongodb+srv://USER:PASSWORD@cluster.mongodb.net/daybook?retryWrites=true&w=majority
MONGODB_URI=
# Long random string (32+ chars): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173
APP_URL=http://localhost:5173
MAIL_FROM="Daybook <no-reply@your-domain.com>"
# Leave SMTP_HOST empty in development: emails are written to backend/outbox/ instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
